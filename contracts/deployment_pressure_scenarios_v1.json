      "pass_condition": "promotion_remains_on_hold_until_lineage_is_verified",
      "fail_condition": "promotion_continues_with_unverified_lineage",
      "max_allowed_blast_radius": "single_candidate_surface",
      "required_orchestrator_decision": "HOLD",
      "required_recovery_action": "restore_from_last_verified_lineage_record"
    },
    {
      "scenario_id": "partial_rollback_failure",
      "failure_type": "rollback_completeness_failure",
      "simulated_trigger": "rollback_restores_assets_but_not_mapping_state",
      "expected_survivable_behavior": "block_further_promotion_and_isolate_incomplete_rollback",
      "measurement_method": "verify_asset_state_and_mapping_state_return_to_same_snapshot",
      "pass_condition": "rollback_is_marked_incomplete_and_no_new_promotion_occurs",
      "fail_condition": "environment_accepts_mixed_rollback_state",
      "max_allowed_blast_radius": "single_rollback_target",
      "required_orchestrator_decision": "BLOCK",
      "required_recovery_action": "complete_snapshot_restoration_before_retry"
    },
    {
