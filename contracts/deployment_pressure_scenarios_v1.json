      "pass_condition": "leaked_state_blocks_promotion",
      "fail_condition": "production_candidate_accepts_staging_state",
      "max_allowed_blast_radius": "single_state_snapshot",
      "required_orchestrator_decision": "BLOCK",
      "required_recovery_action": "purge_cross_environment_state_and_rebuild_snapshot"
    },
    {
      "scenario_id": "replay_reconstruction_failure",
      "failure_type": "replay_integrity_failure",
      "simulated_trigger": "event_replay_cannot_reconstruct_expected_candidate_state",
      "expected_survivable_behavior": "hold_candidate_until_replay_matches_expected_state",
      "measurement_method": "compare_replayed_state_hash_against_candidate_state_hash",
      "pass_condition": "candidate_remains_on_hold_when_replay_mismatch_exists",
      "fail_condition": "candidate_is_accepted_without_replay_reconstruction",
      "max_allowed_blast_radius": "single_candidate_replay",
      "required_orchestrator_decision": "HOLD",
      "required_recovery_action": "repair_event_sequence_or_rebuild_candidate_from_verified_events"
    },
    {
      "scenario_id": "observability_event_saturation",
