      "failure_type": "domain_mapping_visibility_failure",
      "simulated_trigger": "domain_mapping_exists_without_declared_registry_entry",
      "expected_survivable_behavior": "block_activation_until_mapping_is_declared_and_reviewed",
      "measurement_method": "compare_domain_mapping_inventory_against_declared_registry",
      "pass_condition": "hidden_mapping_blocks_activation",
      "fail_condition": "hidden_mapping_is_treated_as_valid_authority",
      "max_allowed_blast_radius": "single_domain_mapping",
      "required_orchestrator_decision": "BLOCK",
      "required_recovery_action": "declare_mapping_or_remove_unregistered_mapping"
    },
    {
      "scenario_id": "cross_environment_state_leakage",
