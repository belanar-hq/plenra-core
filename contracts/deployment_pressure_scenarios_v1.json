    {
      "scenario_id": "blast_radius_underestimation",
      "failure_type": "impact_boundary_failure",
      "simulated_trigger": "candidate_surface_references_more_dependencies_than_declared",
      "expected_survivable_behavior": "block_promotion_until_dependency_boundary_is_corrected",
      "measurement_method": "compare_declared_dependencies_against_discovered_references",
      "pass_condition": "promotion_blocks_when_discovered_dependencies_exceed_declared_radius",
      "fail_condition": "promotion_uses_underestimated_blast_radius",
      "max_allowed_blast_radius": "declared_candidate_dependencies",
      "required_orchestrator_decision": "BLOCK",
      "required_recovery_action": "expand_or_reduce_declared_boundary_and_revalidate"
    },
    {
      "scenario_id": "authority_ambiguity_during_rollback",
      "failure_type": "rollback_authority_ambiguity",
      "simulated_trigger": "multiple_rollback_authorities_claim_final_decision",
      "expected_survivable_behavior": "hold_rollback_until_single_authority_record_is_resolved",
      "measurement_method": "count_distinct_authority_claims_for_same_rollback_decision",
      "pass_condition": "rollback_is_held_when_authority_is_ambiguous",
      "fail_condition": "rollback_executes_under_conflicting_authority_claims",
      "max_allowed_blast_radius": "single_rollback_decision",
      "required_orchestrator_decision": "HOLD",
      "required_recovery_action": "resolve_single_recorded_authority_before_rollback"
    },
    {
      "scenario_id": "expired_surface_not_archived",
      "failure_type": "surface_retirement_failure",
      "simulated_trigger": "surface_expiration_date_passed_without_archive_record",
      "expected_survivable_behavior": "hold_surface_reuse_until_archive_state_is_recorded",
      "measurement_method": "compare_surface_expiration_registry_against_archive_records",
      "pass_condition": "expired_surface_cannot_be_reused_without_archive_record",
      "fail_condition": "expired_surface_is_reused_as_active_surface",
      "max_allowed_blast_radius": "single_expired_surface",
      "required_orchestrator_decision": "HOLD",
      "required_recovery_action": "archive_expired_surface_or_record_valid_extension"
    },
    {
      "scenario_id": "duplicated_production_promotion_attempt",
      "failure_type": "duplicate_promotion_attempt",
      "simulated_trigger": "same_candidate_id_submitted_for_promotion_more_than_once",
      "expected_survivable_behavior": "block_duplicate_attempt_and_preserve_original_decision_record",
      "measurement_method": "compare_candidate_id_against_prior_promotion_attempt_records",
      "pass_condition": "duplicate_attempt_is_blocked",
      "fail_condition": "duplicate_attempt_creates_new_production_promotion_path",
      "max_allowed_blast_radius": "single_candidate_id",
      "required_orchestrator_decision": "BLOCK",
      "required_recovery_action": "link_duplicate_attempt_to_original_decision_record"
    }
