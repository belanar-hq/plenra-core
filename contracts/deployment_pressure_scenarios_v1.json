      "pass_condition": "promotion_is_held_when_manifest_drift_exists",
      "fail_condition": "drifted_artifact_is_promoted",
      "max_allowed_blast_radius": "staging_candidate_only",
      "required_orchestrator_decision": "HOLD",
      "required_recovery_action": "reconcile_manifests_and_revalidate_candidate"
    },
    {
      "scenario_id": "orphan_microsite_accumulation",
