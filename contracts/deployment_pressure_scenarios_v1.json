      "simulated_trigger": "event_volume_exceeds_reviewable_threshold",
      "expected_survivable_behavior": "hold_decision_until_signal_volume_is_reduced_to_reviewable_set",
      "measurement_method": "count_observability_events_against_review_threshold",
      "pass_condition": "decision_is_held_when_events_exceed_review_threshold",
      "fail_condition": "promotion_decision_is_made_from_saturated_event_stream",
      "max_allowed_blast_radius": "observability_window_only",
      "required_orchestrator_decision": "HOLD",
      "required_recovery_action": "deduplicate_events_and_reconstruct_reviewable_signal_window"
