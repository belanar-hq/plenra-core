      "pass_condition": "new_surface_creation_is_held_when_orphans_exceed_limit",
      "fail_condition": "new_surfaces_are_added_while_orphans_remain_unresolved",
      "max_allowed_blast_radius": "unowned_surface_inventory",
      "required_orchestrator_decision": "HOLD",
      "required_recovery_action": "assign_owner_or_archive_each_orphan_surface"
    },
    {
